# Environment Configuration Template

# API Configuration
MAESTRO_API_KEY=your-api-key-here
MAESTRO_API_URL=http://localhost:3000/api
MAESTRO_API_TIMEOUT=30

# Database Configuration
MAESTRO_DB_PATH=./data/maestro.db
MAESTRO_DB_POOL_SIZE=5

# AI Configuration
AI_PROVIDER=openai
AI_MODEL=gpt-4
AI_API_KEY=your-ai-key
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=500

# Logging
RUST_LOG=debug
LOG_LEVEL=info
LOG_FILE=./logs/maestro.log

# Editor Configuration
EDITOR_DEFAULT_LANGUAGE=javascript
EDITOR_DEFAULT_THEME=dark
EDITOR_TAB_SIZE=4
EDITOR_FONT_SIZE=14
EDITOR_FONT_FAMILY=Fira Code

# Language Servers
LSP_RUST_PATH=rust-analyzer
LSP_JS_PATH=typescript-language-server
LSP_PYTHON_PATH=python-lsp-server

# Development
NODE_ENV=development
DEBUG=maestro:*
VITE_API_URL=http://localhost:3000/api

# Desktop App (Tauri)
TAURI_DEV_URL=http://localhost:5173
TAURI_BUNDLE_IDENTIFIER=com.maestro.dev

# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=3000
WORKERS=4
MAX_CONNECTIONS=1000

# Feature Flags
FEATURE_AI_SUGGESTIONS=true
FEATURE_CODE_GENERATION=true
FEATURE_SNIPPET_MANAGER=true
FEATURE_CLOUD_SYNC=false
FEATURE_PLUGINS=false
